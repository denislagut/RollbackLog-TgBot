{
  "name": "rollback-log-tg-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram channel bot",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
